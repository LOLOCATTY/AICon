# Build output — regenerated by `dotnet build` / scripts\build-package.ps1, never share or commit it.
bin/
obj/

# Packaged releases and their staging folders. This grew to 1.8 GB locally; keep it out of the repo.
dist/

# Visual Studio / Rider local state
.vs/
.idea/
*.user
*.suo

# Generated icons (assets\make-icons.ps1 recreates them on every package build)
assets/icons/

# Never commit configuration that can hold API keys. AICon reads these from
# %APPDATA%\AICon\ at run time, NOT from the repo — keep it that way.
aiconagent.json
ar400ai.json
ar400profiles.json
routines.json

# OS junk
Thumbs.db
desktop.ini

# Autodesk's own reference assemblies (RevitAPI.dll/RevitAPIUI.dll) for a Revit year not installed on
# this machine — used ONLY to compile against (Private=false, same as every other Revit reference in
# AICon.csproj; never redistributed). Autodesk's proprietary DLLs, not ours to publish — get them from
# your own licensed Revit install, or from a colleague's, never from this repo or the internet.
lib/revit-refs/
