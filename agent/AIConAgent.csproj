<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AIConAgent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
    <Product>AICon Agent</Product>
    <RootNamespace>AICon.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared core: tool catalogue, providers, agent loop, config — one source of truth used by
         the MCP server and the in-Revit chat panel too. -->
    <Compile Include="..\shared\*.cs" />
  </ItemGroup>

</Project>
