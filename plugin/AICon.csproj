<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 = Revit 2023/2024. net8.0-windows = Revit 2025. net10.0-windows = Revit 2026 AND 2027 —
         verified by compiler, not assumed, for every jump: 2026 needed its own TFM (System.Runtime
         Version=10.0.0.0, not 8.0.0.0 — Revit did not stay on .NET 8 past 2025 the way it stayed on
         net48 across 2023+2024); 2027 then compiled clean against net10.0-windows unchanged (2026-08-30),
         so it reuses the SAME TFM as 2026 — but NOT the same build: 2026's and 2027's RevitAPI.dll are
         different assemblies (AssemblyVersion 26.5.0.0 vs 27.2.0.0), and whether .NET 10's loader is as
         lenient about that mismatch as .NET Framework's is for net48's 2023-vs-2024 case is UNVERIFIED —
         so this does not rely on it either. See the RevitApiYear property below for how 2026 vs 2027
         share net10.0-windows without sharing a binary.
         ElementId.IntegerValue/ElementId(int) is removed from net8.0-windows/net10.0-windows alike —
         see ElementIdCompat.cs — and System.Web.Script.Serialization does not exist on either — see
         Json.cs. MSBuild builds this project once per TargetFramework into its own subfolder
         (bin\Release\net48\, bin\Release\net8.0-windows\, bin\Release\net10.0-windows\, and
         bin\Release\net10.0-windows-2027\ for the non-default RevitApiYear) — see
         AppendTargetFrameworkToOutputPath below, which used to be false back when there was only one
         target. -->
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AICon</RootNamespace>
    <AssemblyName>AICon</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <Version>3.2.3</Version>
    <Product>AICon</Product>
    <Company>Hossam Yousef</Company>
    <Description>AICon - AI connection for Autodesk Revit. Chat with Claude, Gemini, or a local model to read and edit your model.</Description>
    <!-- The deprecated ElementId.IntegerValue/ElementId(int) API is used in exactly ONE place now —
         ElementIdCompat.cs — which is the deliberate net48 side of the Revit 2023/2024 vs 2025+
         compatibility split (see that file). Nowhere else in the plugin touches it directly. Only
         relevant to the net48 build; net8.0-windows never touches these members at all. -->
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-targets fine as-is — no framework-specific version needed. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Only net48 needs a NuGet-restored reference-assemblies set to compile against; net8.0-windows
         gets its BCL from the SDK directly. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <!-- Providers/agent core parse JSON with System.Text.Json (net48 gets it via NuGet; net8.0-windows
         has it built into the shared framework already — an explicit reference there is redundant and
         risks a version-downgrade warning against whatever the framework ships). -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Served verbatim by the get_authoring_guide tool, so the guide can be corrected without a
         rebuild. Copied next to AICon.dll. -->
    <None Include="..\AUTHORING.md" CopyToOutputDirectory="PreserveNewest" Link="AUTHORING.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared agent core: providers, loop, config, tool catalogue — same files the console host and
         MCP server use, so the in-Revit panel never drifts from them. -->
    <Compile Include="..\shared\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- System.Web.Script.Serialization lives here — .NET Framework only, does not exist on .NET 8 at
         all (see Json.cs's #if NETFRAMEWORK split). System.Net.Http and System.IO.Compression are also
         framework-reference-only syntax on net48; net8.0-windows has both as part of the SDK with no
         <Reference> needed. -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <!-- FileTexts.cs (xlsx chat attachments) uses ZipArchive from System.IO.Compression. -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows' OR '$(TargetFramework)' == 'net10.0-windows'">
    <!-- Harmless noise: Revit's OWN internal DLLs (DetailDBAPI.dll, MassingDBAPI.dll, ...) reference
         slightly different versions of RevitAPI/RevitAPIUI than each other; MSBuild reports every one
         it walks past. Confirmed zero effect on the actual build (0 errors either way). -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- REQUIRED, verified empirically: without this, Microsoft.CodeAnalysis.CSharp's own dependency
         DLLs (Roslyn — used by AiconScriptCompiler.cs for run_code and script Routines) are NOT copied
         to the output folder for this target, unlike net48 where they always were. AICon.dll is loaded
         as a plugin into Revit's already-running process, not run via `dotnet AICon.dll` — there is no
         .deps.json-based resolution happening for it, so every dependency has to sit physically next to
         AICon.dll or the assembly load fails the first time run_code/a script routine actually runs. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <!-- Compiled AND runtime-verified against Revit 2025 (2026-08-23) — see HANDOFF-PROMPT.md. -->
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- 2026 is the default (this machine's own runtime-testable year); build 2027 explicitly:
         dotnet build -f net10.0-windows -p:RevitApiYear=2027
         Redirect ONLY the non-default year's output — 2026 keeps the plain net10.0-windows\ path every
         earlier commit already established, so build-package.ps1/install.ps1 needed no change for it. -->
    <RevitApiYear Condition="'$(RevitApiYear)' == ''">2026</RevitApiYear>
  </PropertyGroup>

  <!-- OutputPath alone is not enough — MSBuild still appends $(TargetFramework) on top of it by
       default (AppendTargetFrameworkToOutputPath defaults to true), which is what put 2027's DLL at
       ...\net10.0-windows-2027\net10.0-windows\ instead of the flat folder intended. Only the
       non-default year needs this; 2026 keeps relying on the normal per-TFM folder every earlier
       commit already established. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows' AND '$(RevitApiYear)' != '2026'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows-$(RevitApiYear)\</OutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' AND '$(RevitApiYear)' == '2026'">
    <!-- No Revit 2026 installed on this machine — these are reference-assembly-only copies from a
         colleague's licensed Revit 2026 install (..\lib\revit-refs\2026\, gitignored — see
         .gitignore's comment for why they are never committed). Used ONLY to compile against
         (Private=false, same as every other Revit reference here); UNVERIFIED beyond "compiles" —
         nothing has run this inside a live Revit 2026 process yet. -->
    <Reference Include="RevitAPI">
      <HintPath>..\lib\revit-refs\2026\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>..\lib\revit-refs\2026\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' AND '$(RevitApiYear)' == '2027'">
    <!-- No Revit 2027 installed on this machine either — same provenance/treatment as 2026's above,
         copies from a colleague's licensed Revit 2027 install (..\lib\revit-refs\2027\, gitignored).
         UNVERIFIED beyond "compiles" — nothing has run this inside a live Revit 2027 process yet. -->
    <Reference Include="RevitAPI">
      <HintPath>..\lib\revit-refs\2027\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>..\lib\revit-refs\2027\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
















